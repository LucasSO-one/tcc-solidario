# Valores de exemplo. Configure os segredos somente no Railway > Variables.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=HOST_DO_SESSION_POOLER;Port=5432;Database=postgres;Username=vittaflow_app.REFERENCIA_DO_PROJETO;Password=SENHA_DO_PAPEL_APP;SSL Mode=VerifyFull;Pooling=true;Maximum Pool Size=10;Timeout=15
Jwt__Key=CHAVE_ALEATORIA_COM_PELO_MENOS_32_BYTES
Jwt__Issuer=TccSolidario
Jwt__Audience=TccSolidario
Security__EncryptionKey=BASE64_DE_32_BYTES_ALEATORIOS
Security__PublicOrigin=https://SEU_DOMINIO.up.railway.app
Security__CspReportOnly=true
Security__AuditRetentionDays=180
# Somente quando todo acesso externo passar por proxy HTTPS confiável (Railway).
Proxy__HttpsTermination=true
Database__AutoMigrate=false
Database__ValidateSchema=true
Database__SeedAdmin=false
DadosTeste__Ativo=false
Email__SmtpHost=HOST_SMTP
Email__SmtpPort=587
Email__StartTls=true
Email__Usuario=USUARIO_SMTP
Email__Senha=SEGREDO_SMTP
Email__Remetente=REMETENTE_VERIFICADO_NO_PROVEDOR
# Use Cloudinary completo OU volume persistente montado (consulte SEGURANCA.md).
Cloudinary__CloudName=SEU_CLOUD_NAME
Cloudinary__ApiKey=SUA_API_KEY
Cloudinary__ApiSecret=SEU_API_SECRET
# Alternativa, removendo as três variáveis Cloudinary:
# Storage__PersistentDirectory=/data/vittaflow
